[Unit]
Description=Mobi-Rent farm hardware agent (ADB heartbeat, provisioning, health)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=mobirent
WorkingDirectory=/opt/mobi-rent-agent
EnvironmentFile=/opt/mobi-rent-agent/.env
Environment=MOBI_RENT_DEPLOY_ROLE=farm
ExecStart=/opt/mobi-rent-agent/.venv/bin/python /opt/mobi-rent-agent/main.py
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
