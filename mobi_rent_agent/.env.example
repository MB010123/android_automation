# Copy to .env and fill in required values. Never commit .env.

# Production VoidFix stays off unless VOIDFIX_ENABLED=true is set explicitly.



APP_NAME=mobi-rent-agent

SUPABASE_URL=https://your-project.supabase.co

SUPABASE_ANON_KEY=your-supabase-anon-key

# Do not set SUPABASE_SERVICE_ROLE_KEY. The VPS does not use it.
# Tenant reads/writes go through the Lovable server API below.

SUPABASE_TABLE=slots

HARDWARE_AGENT_TOKEN=your-agent-token



HEARTBEAT_INTERVAL_SECONDS=15

REQUEST_TIMEOUT_SECONDS=10

LOG_LEVEL=INFO

LOG_FILE=logs/agent.log

ADB_PATH=adb

SLOT_MAP_PATH=



# HEARTBEAT_ENDPOINT=



# ---- Phase 2 (all off until explicitly filled in) ----

# PROVISIONING_ENDPOINT=

# PROVISIONING_ALLOWED_SLOT_IDS=1

# REAL_ESIM_ENABLED=false

# ESIM_LIVE_DOWNLOAD_ARMED=false

# PROXY_ROUTES_PATH=

# HEALTH_MONITOR_ENABLED=false

# HEALTH_RECOVERY_ENABLED=false

# FARM_MAX_CONCURRENT=4

# SMS_MAX_ATTEMPTS=1



# VoidFix SMS gateway. Disabled by default even if VOIDFIX_API_KEY is set.

VOIDFIX_ENABLED=false

# VOIDFIX_API_KEY=

# VOIDFIX_SEND_ENDPOINT=https://sms.voidfix.com/services/send.php

# VOIDFIX_INBOUND_ENDPOINT=

# VOIDFIX_ALLOWED_SLOT_IDS=

# VOIDFIX_DEVICE_MAP_PATH=voidfix_devices.json

# VOIDFIX_WEBHOOK_SECRET=

# VOIDFIX_LIVE_SEND_AUTHORIZED=false

# VOIDFIX_DRY_RUN=true

# VOIDFIX_RECIPIENT_ALLOWLIST=

# VOIDFIX_SIM_SLOT_SEND_ENABLED=true

# VOIDFIX_READ_MESSAGES_ENDPOINT=https://sms.voidfix.com/services/read-messages.php

# VOIDFIX_DELIVERY_POLL_ENABLED=true

# VOIDFIX_DELIVERY_POLL_INTERVAL_SECONDS=5

# VOIDFIX_DELIVERY_POLL_TIMEOUT_SECONDS=180



# Durable SMS outbox (absolute path recommended on Linux)

# SMS_OUTBOX_DB_PATH=/opt/mobi-rent-agent/logs/sms_outbox.sqlite



# Inbound webhook listener (systemd mobi-rent-voidfix-webhook.service)

# VOIDFIX_WEBHOOK_LISTEN_HOST=127.0.0.1

# VOIDFIX_WEBHOOK_LISTEN_PORT=8787

# VOIDFIX_WEBHOOK_PATH=/voidfix/inbound

# Set empty to disable raw capture files in production:

# VOIDFIX_WEBHOOK_CAPTURE_DIR=

# MOBI_RENT_ENV_FILE=/opt/mobi-rent-agent/.env

# Two-machine: VPS ↔ physical PC (see DEPLOYMENT.md)
# FARM_AGENT_URL=http://10.0.0.2:8790
# FARM_AGENT_API_TOKEN=
# FARM_AGENT_LISTEN_HOST=127.0.0.1
# FARM_AGENT_LISTEN_PORT=8790
# VPS_BACKEND_LISTEN_HOST=127.0.0.1
# VPS_BACKEND_LISTEN_PORT=8080
# INBOUND_MESSAGES_DB_PATH=/opt/mobi-rent-agent/logs/inbound_messages.sqlite
# OUTBOUND_JOBS_DB_PATH=/opt/mobi-rent-agent/logs/outbound_jobs.sqlite

# Webhook → outbound SMS (default off; see docs/WEBHOOK_OUTBOUND_SMS.md)
# WEBHOOK_AUTO_REPLY_ENABLED=false
# WEBHOOK_AUTO_REPLY_RULES=inbound:1->send:1->to:2
# WEBHOOK_AUTO_REPLY_BODY_PREFIX=
# WEBHOOK_FARM_DISPATCH_TIMEOUT_SECONDS=180
# WEBHOOK_FARM_DISPATCH_MAX_ATTEMPTS=3
# Real map is runtime config (gitignored); copy slot_msisdn_map.example.json and fill in.
# SLOT_MSISDN_MAP_PATH=slot_msisdn_map.json

# Lovable server → VPS farm/operator API (never expose to browser)
# FARM_SERVICE_TOKEN=

# VPS → Lovable server API (separate trust boundary; never expose to browser)
# Generate at least 32 random bytes (for example: python -c "import secrets; print(secrets.token_urlsafe(32))")
# Configure the same value on the Lovable server. Do not reuse FARM_SERVICE_TOKEN.
# LOVABLE_API_URL=https://your-lovable-app.example/api/vps
# VPS_TO_LOVABLE_API_TOKEN=
# OUTBOUND_MESSAGES_DB_PATH=/opt/mobi-rent-agent/logs/outbound_api_messages.sqlite
# VPS_SMS_RATE_LIMIT_PER_SLOT=10
# VPS_SMS_RATE_LIMIT_GLOBAL=120
# SLOT_PUBLIC_ID_MAP_PATH=
# VPS_JOBS_DB_PATH=/opt/mobi-rent-agent/logs/vps_jobs.sqlite
# FARM_DEFAULT_BOX=POD_01
# VPS_MGMT_RATE_LIMIT_PER_SLOT=20
# VPS_MGMT_RATE_LIMIT_GLOBAL=200
# VPS_FARM_HEARTBEAT_INTERVAL_SECONDS=30
# LOVABLE_INBOUND_WEBHOOK_URL=https://your-lovable-app/api/public/farm/inbound-sms
# LOVABLE_INBOUND_WEBHOOK_HMAC_SECRET=

# VPS user authentication is Supabase Auth (auth.users + profiles).
# Tenant tables stay on Lovable/Supabase and are reached via LOVABLE_API_URL.
# Farm jobs / heartbeat / SMS dispatch queue stay on VPS SQLite.
# SUPABASE_URL and SUPABASE_ANON_KEY are required to validate user tokens (and optional /auth/* proxy).
# Optional HS256 local verify of Supabase access tokens (project JWT secret, not the anon key).
# SUPABASE_JWT_SECRET=
# Optional cookie store for the Supabase access token (not a second VPS JWT).
# VPS_AUTH_COOKIE_NAME=
# VPS_AUTH_COOKIE_SECURE=true
# VPS_ALLOWED_ORIGINS=https://your-lovable-frontend.example
# VPS_AUTH_RATE_LIMIT=10
# VPS_AUTH_RATE_WINDOW_SECONDS=60
# VPS_AUTH_RATE_MAX_KEYS=4096
# VPS_ESIM_ALLOWED_URL_PREFIXES=

# ---- Customer in-app remote access (bays 1–20; OFF by default) ----
# See docs/IN_APP_SETUP_SESSION.md and docs/REMOTE_ACCESS_POC.md.
# Set REMOTE_ACCESS_POC_ENABLED on BOTH the VPS (routes) and the farm PC
# (QR / observation farm tasks). Nothing below enables silent eSIM install;
# the customer completes the normal Android eSIM UI on the in-app phone screen.
# REMOTE_ACCESS_POC_ENABLED=false
# Leftover named allowlist. Unused by customer QR, stream, control, observation,
# or complete. Do not use this to gate production in-app setup.
# REMOTE_ACCESS_POC_SLOT_IDS=1
# Companion/admin silent provision_esim stays Slot 1 unless you intentionally
# widen that separate path:
# PROVISIONING_ALLOWED_SLOT_IDS=1
# GADS hub as seen from the VPS backend (server-side only, never sent to browsers):
# REMOTE_ACCESS_PLATFORM_URL=http://127.0.0.1:10000
# Optional public GADS URL (admin/ops). Customer in-app setup does not open it:
# REMOTE_ACCESS_PUBLIC_URL=https://remote.example.com
# Dedicated GADS admin used only by the backend to mint per-rental users/leases:
# REMOTE_ACCESS_ADMIN_USERNAME=
# REMOTE_ACCESS_ADMIN_PASSWORD=
# Slot 1 fallback workspace id if gads_workspaces.json omits bay 1:
# REMOTE_ACCESS_WORKSPACE_ID=
# JSON map of bay -> unique GADS workspace id (required for all 20 bays):
# REMOTE_ACCESS_WORKSPACE_MAP_PATH=/opt/mobi-rent-agent/gads_workspaces.json
# Optional extra GADS enable list (CSV). Unset = every bay with a unique workspace.
# REMOTE_ACCESS_SLOT_IDS=
# Unset prepare/observe = every GADS-enabled bay. Set a CSV only to restrict.
# Do NOT leave these at 1 on production if all 20 bays should complete setup.
# REMOTE_ACCESS_PREPARE_SLOT_IDS=
# REMOTE_ACCESS_OBSERVE_SLOT_IDS=
# VOIDFIX_ANDROID_PACKAGE=com.example.voidfix
# Package of the VoidFix SMS app on the Pixel. Used only to observe default-SMS
# approval and to restart that app process after the customer confirms in Android.
# Never silently assigned as ROLE_SMS.

# Per-grant lease TTL in minutes (5..360; capped by rental end):
# REMOTE_ACCESS_SESSION_TTL_MINUTES=60
# Reboot wait (ADB back online, then GADS provider back online):
# REMOTE_ACCESS_REBOOT_TIMEOUT_SECONDS=180
# Optional farm-side re-check of QR hosts (CSV). If unset, Farm Agent still
# requires public HTTPS; the VPS allowlist is the authority.
# REMOTE_ACCESS_QR_URL_PREFIXES=

