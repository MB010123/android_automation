# Isolated prototype environment. Copy to prototype.env (gitignored).
# Never copy these values into the production mobi_rent_agent/.env to enable
# farm VoidFix or farm eSIM.

PROTOTYPE_ENVIRONMENT=prototype
PROTOTYPE_MODE=PRODUCTION_DISABLED

# CSV of prototype device IDs from prototype_devices.json. Empty uses
# devices with enabled=true only.
PROTOTYPE_DEVICE_ALLOWLIST=prototype-device-1

# Harmless test recipient. Use E.164. Do not commit real numbers.
PROTOTYPE_RECIPIENT_ALLOWLIST=

PROTOTYPE_LOG_DIR=logs/prototype

# Production farm VoidFix stays off. These flags apply only when the
# prototype runner loads this file. Do not set VOIDFIX_ENABLED=true in
# the production .env as part of prototype work.
VOIDFIX_ENABLED=false
VOIDFIX_API_KEY=
VOIDFIX_SEND_ENDPOINT=https://sms.voidfix.com/services/send.php
VOIDFIX_INBOUND_ENDPOINT=
VOIDFIX_WEBHOOK_SECRET=
VOIDFIX_REAL_SEND_CONFIRMATION=false
