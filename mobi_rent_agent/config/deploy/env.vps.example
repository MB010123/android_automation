# VPS .env template — copy to /opt/mobi-rent-agent/.env (never commit secrets).
MOBI_RENT_DEPLOY_ROLE=vps
APP_NAME=mobi-rent-agent

# Lovable / Supabase (if VPS serves API routes later; required by load_config today)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
HARDWARE_AGENT_TOKEN=your-agent-token

LOG_LEVEL=INFO
LOG_FILE=/opt/mobi-rent-agent/logs/vps-backend.log
REQUEST_TIMEOUT_SECONDS=10

# VoidFix inbound (no outbound SMS required on VPS for webhook-only phase)
VOIDFIX_ENABLED=false
VOIDFIX_DEVICE_MAP_PATH=/opt/mobi-rent-agent/voidfix_devices.json
# VOIDFIX_WEBHOOK_SECRET=

# VPS HTTP (nginx terminates TLS → 127.0.0.1:8080)
VPS_BACKEND_LISTEN_HOST=127.0.0.1
VPS_BACKEND_LISTEN_PORT=8080
VOIDFIX_WEBHOOK_PATH=/voidfix/inbound
INBOUND_MESSAGES_DB_PATH=/opt/mobi-rent-agent/logs/inbound_messages.sqlite

# Physical PC status (VPN/WireGuard/private IP — not public without firewall rules)
FARM_AGENT_URL=http://10.0.0.2:8790
FARM_AGENT_API_TOKEN=generate-long-random-token

# Lovable / server → VPS (never expose to browsers)
# FARM_SERVICE_TOKEN=generate-long-random-token
