# Physical PC .env template — USB phones stay on this machine.
MOBI_RENT_DEPLOY_ROLE=farm
APP_NAME=mobi-rent-agent

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
HARDWARE_AGENT_TOKEN=your-agent-token
HEARTBEAT_ENDPOINT=
HEARTBEAT_INTERVAL_SECONDS=15
LOG_LEVEL=INFO
LOG_FILE=/opt/mobi-rent-agent/logs/agent.log
ADB_PATH=adb
SLOT_MAP_PATH=/opt/mobi-rent-agent/slot_map.json

# Production SMS (unchanged; stays on farm PC)
VOIDFIX_ENABLED=true
# VOIDFIX_API_KEY=
VOIDFIX_DEVICE_MAP_PATH=/opt/mobi-rent-agent/voidfix_devices.json
# VOIDFIX_ALLOWED_SLOT_IDS=1,2,...,20
# VOIDFIX_RECIPIENT_ALLOWLIST=+1...
# VOIDFIX_LIVE_SEND_AUTHORIZED=
# VOIDFIX_DRY_RUN=
# VOIDFIX_SIM_SLOT_SEND_ENABLED=true
# VOIDFIX_DELIVERY_POLL_ENABLED=true
SMS_OUTBOX_DB_PATH=/opt/mobi-rent-agent/logs/sms_outbox.sqlite

# Farm status API for VPS (bind on private interface; firewall allow VPS only)
FARM_AGENT_LISTEN_HOST=0.0.0.0
FARM_AGENT_LISTEN_PORT=8790
FARM_AGENT_API_TOKEN=same-token-as-vps-FARM_AGENT_API_TOKEN
